{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "field-shift",
  "title": "Field Shift · contrat entre le front end et l'algorithme",
  "description": "Version 1.0. Toutes les opérations sont des POST JSON. Voir docs/ALGO_CONTRACT.md.",
  "definitions": {
    "CropId": { "enum": ["mais", "soya", "ble", "orge", "patate", "luzerne"] },
    "CoverId": { "enum": ["seigle", "trefle", "radis", null] },
    "Score": { "type": "integer", "minimum": 0, "maximum": 100 },
    "Scores": {
      "type": "object",
      "required": ["eau", "sol", "resilience", "revenu"],
      "properties": {
        "eau": { "$ref": "#/definitions/Score" },
        "sol": { "$ref": "#/definitions/Score" },
        "resilience": { "$ref": "#/definitions/Score" },
        "revenu": { "$ref": "#/definitions/Score" }
      }
    },
    "Range": {
      "description": "[bas, haut], en pourcentage. Ex. [6, 9] = « +6 à +9 % ».",
      "type": "array",
      "items": { "type": "number" },
      "minItems": 2,
      "maxItems": 2
    },
    "RotationEntry": {
      "type": "object",
      "required": ["crop", "years"],
      "properties": {
        "crop": { "$ref": "#/definitions/CropId" },
        "years": { "type": "integer", "minimum": 1, "maximum": 3 },
        "cover": { "$ref": "#/definitions/CoverId" }
      }
    },
    "Section": {
      "type": "object",
      "required": ["id", "areaHa", "offset", "rotation"],
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 3 },
        "areaHa": { "type": "number", "exclusiveMinimum": 0 },
        "offset": {
          "type": "integer",
          "minimum": 0,
          "description": "Position dans le cycle la première année (décalage entre sections)."
        },
        "note": { "type": "string" },
        "currentCrop": {
          "enum": ["mais", "soya", "ble", "orge", "patate", "luzerne", null],
          "description": "Ce qui pousse sur la section maintenant (la saison avant startYear), ou null. La première année analysée doit respecter le délai de retour après cette culture."
        },
        "polygon": {
          "type": "array",
          "description": "Coins de la section, [latitude, longitude].",
          "items": {
            "type": "array",
            "items": { "type": "number" },
            "minItems": 2,
            "maxItems": 2
          }
        },
        "rotation": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/definitions/RotationEntry" }
        }
      }
    },
    "FarmInput": {
      "type": "object",
      "required": ["version", "farm", "sections"],
      "properties": {
        "version": { "const": "1.0" },
        "farm": {
          "type": "object",
          "required": ["type", "startYear", "horizonYears", "priorities", "sensors"],
          "properties": {
            "id": { "type": "string" },
            "name": { "type": "string" },
            "type": { "const": "grandes-cultures" },
            "location": {
              "type": "object",
              "required": ["lat", "lon"],
              "properties": {
                "lat": { "type": "number", "minimum": -90, "maximum": 90 },
                "lon": { "type": "number", "minimum": -180, "maximum": 180 },
                "label": { "type": "string" }
              }
            },
            "seeds": {
              "type": "object",
              "description": "Réserve de semences du fermier. /propose n'utilise que ces cultures et couvertures ; absent = tout le catalogue.",
              "required": ["crops"],
              "properties": {
                "crops": {
                  "type": "array",
                  "items": { "$ref": "#/definitions/CropId" },
                  "uniqueItems": true
                },
                "covers": {
                  "type": "array",
                  "items": { "enum": ["seigle", "trefle", "radis"] },
                  "uniqueItems": true
                }
              }
            },
            "boundary": {
              "type": "array",
              "description": "Contour de la ferme, [latitude, longitude].",
              "items": {
                "type": "array",
                "items": { "type": "number" },
                "minItems": 2,
                "maxItems": 2
              }
            },
            "startYear": { "type": "integer", "minimum": 2000 },
            "horizonYears": {
              "type": "integer",
              "minimum": 1,
              "maximum": 30,
              "description": "Durée d'analyse commune à toute la ferme."
            },
            "priorities": {
              "type": "array",
              "description": "Du plus important au moins important.",
              "items": { "enum": ["revenu", "resilience", "sol", "eau", "travail"] },
              "minItems": 5,
              "maxItems": 5,
              "uniqueItems": true
            },
            "sensors": { "type": "boolean" }
          }
        },
        "options": {
          "type": "object",
          "properties": {
            "stressYears": {
              "enum": [1, 3],
              "description": "Durée d'un choc du stress test, en années."
            }
          }
        },
        "sections": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/definitions/Section" }
        }
      }
    },
    "SectionPlan": {
      "type": "object",
      "required": [
        "id",
        "scores",
        "confidence",
        "comparisons",
        "revenue",
        "workload",
        "stress",
        "suggestions",
        "explanations"
      ],
      "properties": {
        "id": { "type": "string" },
        "scores": { "$ref": "#/definitions/Scores" },
        "confidence": { "enum": ["elevee", "moyenne", "faible"] },
        "comparisons": {
          "type": "object",
          "required": ["mais-continu", "mais-soya"],
          "additionalProperties": {
            "type": "object",
            "required": ["yieldGainPct", "revenueDeltaPerHaYear", "scores"],
            "properties": {
              "yieldGainPct": { "$ref": "#/definitions/Range" },
              "revenueDeltaPerHaYear": { "type": "number" },
              "scores": { "$ref": "#/definitions/Scores" }
            }
          }
        },
        "revenue": {
          "type": "object",
          "required": ["perHaYear", "series", "baselines"],
          "properties": {
            "perHaYear": { "type": "number" },
            "series": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["year", "value", "low", "high"],
                "properties": {
                  "year": { "type": "integer" },
                  "value": { "type": "number" },
                  "low": { "type": "number" },
                  "high": { "type": "number" }
                }
              }
            },
            "baselines": {
              "type": "object",
              "required": ["mais-continu", "mais-soya"],
              "additionalProperties": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": ["year", "value"],
                  "properties": {
                    "year": { "type": "integer" },
                    "value": { "type": "number" }
                  }
                }
              }
            }
          }
        },
        "workload": { "enum": ["faible", "moyenne", "elevee"] },
        "stress": {
          "type": "object",
          "required": ["normal", "sec", "chaud", "ravageurs"],
          "additionalProperties": {
            "type": "object",
            "required": ["yieldPct", "baselineYieldPct", "scores"],
            "properties": {
              "yieldPct": { "$ref": "#/definitions/Range" },
              "baselineYieldPct": { "$ref": "#/definitions/Range" },
              "scores": { "$ref": "#/definitions/Scores" }
            }
          }
        },
        "suggestions": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["code", "message"],
            "properties": {
              "code": { "type": "string" },
              "message": { "type": "string" },
              "scenario": { "enum": ["normal", "sec", "chaud", "ravageurs"] },
              "yieldPctAfter": { "$ref": "#/definitions/Range" }
            }
          }
        },
        "explanations": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["code", "message"],
            "properties": { "code": { "type": "string" }, "message": { "type": "string" } }
          }
        },
        "warnings": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["code", "message"],
            "properties": { "code": { "type": "string" }, "message": { "type": "string" } }
          }
        }
      }
    },
    "FarmPlan": {
      "type": "object",
      "required": ["version", "meta", "farm", "sections"],
      "properties": {
        "version": { "const": "1.0" },
        "meta": {
          "type": "object",
          "required": ["engine", "demo"],
          "properties": {
            "engine": { "type": "string" },
            "demo": {
              "type": "boolean",
              "description": "true = chiffres d'exemple ; l'interface affiche le badge « Données d'exemple »."
            },
            "generatedAt": { "type": "string" }
          }
        },
        "farm": {
          "type": "object",
          "required": ["score", "revenuePerYear"],
          "properties": {
            "score": { "$ref": "#/definitions/Score" },
            "revenuePerYear": { "type": "number" }
          }
        },
        "sections": { "type": "array", "items": { "$ref": "#/definitions/SectionPlan" } }
      }
    },
    "ProposeRequest": {
      "type": "object",
      "required": ["farm", "sectionId", "cycleYears"],
      "properties": {
        "farm": { "$ref": "#/definitions/FarmInput" },
        "sectionId": { "type": "string" },
        "cycleYears": { "type": "integer", "minimum": 1, "maximum": 8 }
      }
    },
    "ProposeResponse": {
      "type": "object",
      "required": ["rotation", "reasons"],
      "properties": {
        "rotation": { "type": "array", "items": { "$ref": "#/definitions/RotationEntry" } },
        "reasons": { "type": "array", "items": { "type": "string" } },
        "missingSeeds": {
          "type": "array",
          "description": "Cultures utilisées qui ne sont pas dans farm.seeds (seulement quand aucune rotation n'est possible avec la réserve).",
          "items": { "$ref": "#/definitions/CropId" }
        }
      }
    },
    "FieldDataRequest": {
      "type": "object",
      "required": ["farm", "sectionId"],
      "properties": {
        "farm": { "$ref": "#/definitions/FarmInput" },
        "sectionId": { "type": "string" }
      }
    },
    "FieldDataResponse": {
      "type": "object",
      "required": ["sectionId", "metrics"],
      "properties": {
        "sectionId": { "type": "string" },
        "demo": { "type": "boolean" },
        "metrics": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "label", "value", "unit", "source", "explain"],
            "properties": {
              "id": { "type": "string" },
              "label": { "type": "string" },
              "value": { "type": ["number", "string"] },
              "unit": { "type": "string" },
              "source": { "type": "string" },
              "fromSensors": { "type": "boolean" },
              "series": { "type": "array", "items": { "type": "number" } },
              "explain": { "type": "string" }
            }
          }
        }
      }
    }
  }
}
