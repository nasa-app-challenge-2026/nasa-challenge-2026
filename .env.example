# Copier vers apps/api/.env (ou exporter) pour surcharger les valeurs par défaut.
# live : cache local -> API NASA POWER -> instantané vérifié si l'API échoue
# snapshot_only : hors ligne, uniquement les instantanés versionnés (démo sans réseau)
FIELDSHIFT_CLIMATE_SOURCE=live
FIELDSHIFT_POWER_BASE_URL=https://power.larc.nasa.gov
FIELDSHIFT_POWER_TIMEOUT_SECONDS=60
FIELDSHIFT_POWER_MAX_ATTEMPTS=2
FIELDSHIFT_POWER_MAX_CONCURRENT_REQUESTS=2
FIELDSHIFT_CORS_ORIGINS=["http://localhost:5173"]
FIELDSHIFT_LOG_LEVEL=INFO
FIELDSHIFT_LOG_FORMAT=json
