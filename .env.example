# Which engine the front end uses.
#   mock   = built-in demo engine (default, works offline, numbers are fake)
#   remote = the team's real algorithm, called over HTTP (see docs/ALGO_CONTRACT.md)
VITE_ALGO_MODE=mock

# Base URL of the real algorithm when VITE_ALGO_MODE=remote. No trailing slash.
# The front end calls POST {url}/evaluate, {url}/propose and {url}/field-data.
VITE_ALGO_URL=http://localhost:8000
