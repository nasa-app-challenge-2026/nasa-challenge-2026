# Which engine the front end uses.
#   (empty)  = the Field Shift algorithm in the browser, with the real NASA POWER weather (default)
#   remote   = a server that answers POST {url}/plan (see docs/ALGO_CONTRACT.md)
VITE_ALGO_MODE=

# Base URL of the algorithm server when VITE_ALGO_MODE=remote. No trailing slash.
VITE_ALGO_URL=http://localhost:8000

# demo = never call NASA POWER, use the fictitious weather (offline work).
VITE_FARM_WEATHER=
