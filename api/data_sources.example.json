{
  "slope_pct": {
    "url": "https://exemple.org/srtm/pente?lat={lat}&lon={lon}",
    "jsonPath": "pente_pct"
  },
  "ksat_mm_h": {
    "url": "https://exemple.org/ssurgo/ksat?lat={lat}&lon={lon}",
    "jsonPath": "resultats.0.ksat_um_s",
    "scale": 3.6
  },
  "soil_saturation": {
    "url": "https://exemple.org/smap/humidite?latitude={lat}&longitude={lon}",
    "jsonPath": "saturation_pct",
    "scale": 0.01,
    "headers": { "Authorization": "Bearer <jeton Earthdata>" }
  },
  "ndvi": "https://exemple.org/landsat/ndvi?lat={lat}&lon={lon}"
}
