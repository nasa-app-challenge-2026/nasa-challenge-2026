# Modèle du fichier .env : copiez-le en « .env » (même dossier) et remplissez-le.
# Le fichier .env est exclu de git (.gitignore) : il ne doit jamais être poussé dans le repo.
# Partagez-le entre coéquipiers par message privé, ou que chacun crée son compte (gratuit) :
#   https://urs.earthdata.nasa.gov/users/new

# NASA Earthdata : active SMAP et ECOSTRESS (sinon MERRA-2 prend le relais pour le sol)
EARTHDATA_USERNAME=
EARTHDATA_PASSWORD=

# Facultatif : clé api.data.gov gratuite pour relever la limite de requêtes USGS
# https://api.data.gov/signup/
USGS_API_KEY=
